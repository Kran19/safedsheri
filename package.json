{
  "name": "safed-sheri",
  "version": "1.0.0",
  "private": true,
  "description": "Safed Sheri Specialized Operational Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "deploy": "bash deploy.sh",
    "dev": "concurrently -n \"API,ADMIN\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:all": "npm run dev",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "build:types": "npm run build --workspace=packages/types",
    "build:api": "npm run build --workspace=apps/api",
    "build:admin": "npm run build --workspace=apps/admin",
    "start:api": "npm run start:dev --workspace=apps/api",
    "start:admin": "npm run dev --workspace=apps/admin",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "npx ts-node prisma/seed.ts",
    "prisma:seed:admins": "npx ts-node prisma/seed-admins.ts",
    "test:e2e": "npx ts-node scripts/e2e-verification.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "prisma": "^5.10.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
