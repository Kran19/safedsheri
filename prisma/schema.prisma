datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  TICKETING_FINANCE
  ENTRY_VERIFICATION
  ATTENDEE
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum PassType {
  SINGLE
  COUPLE
  GAZEBO
  KIDS
}

enum RegistrationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PASS_ISSUED
  REJECTED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentMethod {
  ONLINE_GATEWAY
  UPI_QR
  CUSTOM_DIRECT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

enum CredentialStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

enum ScanResult {
  VALID
  ALREADY_USED
  CANCELLED
  INVALID_TOKEN
  WRONG_EVENT
  PAYMENT_NOT_CONFIRMED
  EXPIRED
}

enum EntryType {
  QR
  DIRECT
  MANUAL
}

enum VerificationMethod {
  QR_SCAN
  CASHIER
  MANUAL
}

enum GazeboStatus {
  AVAILABLE
  HELD
  CONFIRMED
}

enum GazeboInquiryStatus {
  NEW
  CONTACTED
  DISCUSSION
  HOLD
  APPROVED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(ATTENDEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrationsCreated  Registration[]  @relation("CreatedBy")
  registrationsReviewed Registration[]  @relation("ReviewedBy")
  paymentsCollected     Payment[]       @relation("CollectedBy")
  entriesVerified       Entry[]         @relation("VerifiedBy")
  scanAttempts          ScanAttempt[]   @relation("ScannedBy")
  auditLogs             AuditLog[]      @relation("Actor")

  @@index([username])
  @@index([role])
}

model Event {
  id        String   @id @default(uuid())
  name      String   @default("Safed Sheri 2026")
  eventDate DateTime // Canonical: 2026-10-09T00:00:00.000Z
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]
  entries       Entry[]
  scanAttempts  ScanAttempt[]

  @@index([status])
  @@index([eventDate])
}

model PricingPhase {
  id                 String    @id @default(uuid())
  phaseName          String    @unique // EARLY_BIRD, REGULAR, FINAL
  singlePrice        Decimal   @db.Decimal(10, 2)
  couplePrice        Decimal   @db.Decimal(10, 2)
  nextSinglePrice    Decimal?  @db.Decimal(10, 2)
  nextCouplePrice    Decimal?  @db.Decimal(10, 2)
  showSinglePrice    Boolean   @default(true)
  showCouplePrice    Boolean   @default(true)
  showGazeboPrice    Boolean   @default(false)
  isCountdownActive  Boolean   @default(false)
  countdownTarget    DateTime?
  urgencyTagline     String?
  hiddenPriceLabel   String?   @default("Price Revealed on Approval")
  isActive           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  registrations Registration[]

  @@index([isActive])
}

model Attendee {
  id               String   @id @default(uuid())
  fullName         String
  phone            String
  email            String?
  gender           Gender   @default(FEMALE)
  aadhaarHmac      String   @unique // HMAC-SHA-256(server_secret, normalized_aadhaar)
  aadhaarMasked    String   // MANDATORY: XXXX XXXX 1234
  aadhaarEncrypted String   // MANDATORY: AES-256-GCM encrypted hex
  kidsAgeGroup     String?  // Optional: 'UNDER_10' or '10_TO_15'
  dob              DateTime? // Date of birth
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  document      AadhaarDocument?
  registrations RegistrationAttendee[]
  credentials   Credential[]
  entries       Entry[]

  @@index([phone])
  @@index([fullName])
  @@index([gender])
  @@index([aadhaarHmac])
}

model AadhaarDocument {
  id               String   @id @default(uuid())
  attendeeId       String   @unique
  storageKey       String   // Private local disk path or secure storage key
  originalFilename String
  mimeType         String   // image/jpeg, image/png, image/webp, application/pdf
  sizeBytes        Int
  checksum         String   // SHA-256 hash of file content
  storageKeyBack       String?
  originalFilenameBack String?
  mimeTypeBack         String?
  sizeBytesBack        Int?
  checksumBack         String?
  ocrExtractedData     String?  // JSON string storing { name, aadhaarNumber, dob, gender, isModifiedAfterOcr, discrepancies: [...] }
  ocrMismatch          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([attendeeId])
}

model Registration {
  id                 String             @id @default(uuid())
  registrationNumber String             @unique // SS-2026-XXXXXX
  eventId            String
  pricingPhaseId     String
  passType           PassType           @default(SINGLE)
  status             RegistrationStatus @default(SUBMITTED)
  amountDue          Decimal            @db.Decimal(10, 2)
  paymentLinkId      String?            @unique // Unique payment order reference
  reviewNotes        String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  event        Event                  @relation(fields: [eventId], references: [id])
  pricingPhase PricingPhase           @relation(fields: [pricingPhaseId], references: [id])
  createdBy    User                   @relation("CreatedBy", fields: [createdById], references: [id])
  reviewedBy   User?                  @relation("ReviewedBy", fields: [reviewedById], references: [id])
  attendees    RegistrationAttendee[]
  payments     Payment[]
  credentials  Credential[]
  entries      Entry[]

  @@index([registrationNumber])
  @@index([status])
  @@index([passType])
  @@index([eventId])
  @@index([pricingPhaseId])
  @@index([paymentLinkId])
}

model RegistrationAttendee {
  registrationId String
  attendeeId     String
  isPrimary      Boolean            @default(false)
  status         RegistrationStatus @default(SUBMITTED)
  reviewNotes    String?
  reviewedAt     DateTime?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attendee     Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@id([registrationId, attendeeId])
  @@index([status])
}

model PaymentLocation {
  id        String   @id @default(uuid())
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([isActive])
}

model Payment {
  id                String        @id @default(uuid())
  registrationId    String
  paymentLocationId String?
  collectedById     String?
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod @default(ONLINE_GATEWAY)
  status            PaymentStatus @default(PENDING)
  receiptNumber     String        @unique // RCP-2026-XXXXXX
  provider          String        @default("SAFED_SHERI_GATEWAY")
  providerReference String?       @unique // PG-TXN-XXXXXX
  paymentLinkId     String?
  notes             String?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  registration    Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  paymentLocation PaymentLocation? @relation(fields: [paymentLocationId], references: [id])
  collectedBy     User?            @relation("CollectedBy", fields: [collectedById], references: [id])

  @@index([receiptNumber])
  @@index([registrationId])
  @@index([providerReference])
  @@index([status])
  @@index([createdAt])
}

model Credential {
  id               String           @id @default(uuid())
  credentialNumber String           @unique // PASS-2026-XXXXXX
  passCode         String           @unique // Visible human code: SS26-SINGLE-XXXX, SS26-COUPLE-XXXX
  registrationId   String
  attendeeId       String
  secureToken      String           @unique // Private QR secret: ss_qr_<64_hex_chars>
  status           CredentialStatus @default(ACTIVE)
  issuedAt         DateTime         @default(now())
  usedAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attendee     Attendee      @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  scanAttempts ScanAttempt[]
  entries      Entry[]

  @@index([secureToken])
  @@index([passCode])
  @@index([credentialNumber])
  @@index([status])
  @@index([attendeeId])
}

model ScanAttempt {
  id              String     @id @default(uuid())
  eventId         String
  credentialId    String?
  scannedById     String
  result          ScanResult
  rawTokenScanned String
  scannedAt       DateTime   @default(now())

  event      Event       @relation(fields: [eventId], references: [id])
  credential Credential? @relation(fields: [credentialId], references: [id])
  scannedBy  User        @relation("ScannedBy", fields: [scannedById], references: [id])

  @@index([eventId])
  @@index([credentialId])
  @@index([scannedById])
  @@index([result])
  @@index([scannedAt])
}

model Entry {
  id                 String             @id @default(uuid())
  eventId            String
  attendeeId         String?
  registrationId     String?
  credentialId       String?
  entryType          EntryType          @default(QR)
  verificationMethod VerificationMethod @default(QR_SCAN)
  verifiedById       String
  notes              String?
  createdAt          DateTime           @default(now())

  event        Event         @relation(fields: [eventId], references: [id])
  attendee     Attendee?     @relation(fields: [attendeeId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])
  credential   Credential?   @relation(fields: [credentialId], references: [id])
  verifiedBy   User          @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@index([eventId])
  @@index([attendeeId])
  @@index([registrationId])
  @@index([credentialId])
  @@index([verifiedById])
  @@index([createdAt])
}

model Gazebo {
  id           String       @id @default(uuid())
  gazeboNumber String       @unique // GZB-L1-01 to GZB-L3-04
  level        Int          // 1, 2, 3
  price        Decimal      @db.Decimal(10, 2)
  status       GazeboStatus @default(AVAILABLE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  inquiries GazeboInquiry[]

  @@index([level])
  @@index([status])
}

model GazeboInquiry {
  id            String              @id @default(uuid())
  inquiryNumber String              @unique // GZB-INQ-XXXXXX
  gazeboId      String?
  level         Int                 // 1, 2, 3
  fullName      String
  phone         String
  notes         String?
  status        GazeboInquiryStatus @default(NEW)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  gazebo Gazebo? @relation(fields: [gazeboId], references: [id])

  @@index([inquiryNumber])
  @@index([level])
  @@index([status])
}

model SponsorInquiry {
  id              String        @id @default(uuid())
  companyName     String
  contactName     String
  phone           String
  email           String?
  sponsorshipType String?
  notes           String?
  status          InquiryStatus @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model StallInquiry {
  id          String        @id @default(uuid())
  brandName   String
  contactName String
  phone       String
  category    String?
  notes       String?
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  action       String
  targetEntity String
  targetId     String?
  payload      Json?
  createdAt    DateTime @default(now())

  actor User @relation("Actor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([targetEntity])
  @@index([createdAt])
}


model SystemSetting {
  key   String @id
  value String
}
